# Ghost in the Logs - Environment Variables
# Copy this to .env and adjust as needed

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Loki
LOKI_URL=http://loki:3100

# Prometheus
PROMETHEUS_URL=http://prometheus:9090

# Ghost API
GHOST_HOST=0.0.0.0
GHOST_PORT=8000
GHOST_DEBUG=false

# SQLite database path (inside container)
GHOST_DB_PATH=/data/ghost.db
CHROMA_PATH=/data/chroma

# Demo system Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ghostdemo
POSTGRES_USER=ghost
POSTGRES_PASSWORD=ghostpass

# Demo system service URLs (internal docker network)
GATEWAY_URL=http://gateway:8001
ORDERS_API_URL=http://orders-api:8002
PAYMENTS_WORKER_URL=http://payments-worker:8003

# Alert webhook path
ALERT_WEBHOOK_SECRET=changeme

# Log level
LOG_LEVEL=INFO
